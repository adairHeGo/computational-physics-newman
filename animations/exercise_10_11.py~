import random as rd
import numpy as np
from math import exp
import vpython as vp

def E(G):
    return -np.count_nonzero(G)/2

Solid = np.zeros((50,50))
Solid_grid = np.empty((50,50))
for i in range(50):
    for j in range(50):
        Solid_grid[i,j] = vp.sphere(pos=vp.vec(i,j,0), color=vp.color.white)

#Place a dimmer
Tmax = 10.0
Tmin = 1e-3
tau = 1e6

t = 0
T = Tmax

dim1 = 2
dim2 = 3

while T>Tmin:
    i1 = rd.randrange(50)
    j1 = rd.randrange(50)
    t += 1
    T = Tmax*exp(-t/tau)
    r = rd.random()
    if i1 == 0 and j1==0:
        if r<0.5:
            i2 = 1
            j2 = 0
        else:
            j2 = 1
            i2 = 0
    elif i1 == 49 and j1==0:
        if r<0.5:
            i2 = -1
            j2 = 0
        else:
            j2 = 1
            i2 = 0
    elif i1 == 0 and j1==49:
        if r<0.5:
            i2 = 1
            j2 = 0
        else:
            j2 = -1
            i2 = 0
    elif i1 == 49 and j1==49:
        if r<0.5:
            i2 = -1
            j2 = 0
        else:
            j2 = -1
            i2 = 0
    elif i1 == 0:
        if r<1/3:
            i2 = 1
            j2 = 0
        elif r<2/3:
            j2 = 1
            i2 = 0
        else:
            j2 = -1
            i2 = 0
    elif i1 == 49:
        if r<1/3:
            i2 = -1
            j2 = 0
        elif r<2/3:
            j2 = 1
            i2 = 0
        else:
            j2 = -1
            i2 = 0
    elif j1 == 0:
        if r<1/3:
            i2 = 1
            j2 = 0
        elif r<2/3:
            i2 = -1
            j2 = 0
        else:
            j2 = 1
            i2 = 0
    elif j1 == 49:
        if r<1/3:
            i2 = 1
            j2 = 0
        elif r<2/3:
            i2 = -1
            j2 = 0
        else:
            j2 = -1
            i2 = 0
    else:
        if r<0.25:
            i2 = 1
            j2 = 0
        elif r<0.5:
            i2 = -1
            j2 = 0
        elif r<0.75:
            i2 = 0
            j2 = 1
        else:
            i2 = 0
            j2 = -1
    if Solid[i1,j1]==0 and Solid[i1+i2,j1+j2]==0:
        if rd.random()<exp(1/T):
            Solid[i1,j1] = dim1
            Solid[i1+i2,j1+j2] = dim2
            Solid_grid[i1,j1].color = vp.color.cyan
            Solid_grid[i1+i2,j1+j2].color = vp.color.cyan
            dim1 += 3
            dim2 += 3
    elif abs(Solid[i1,j1] - Solid[i1+i2,j1+j2]) == 1:
        if rd.random()<exp(-1/T):
            Solid[i1,j1] = 0
            Solid[i1+i2,j1+j2] = 0
            Solid_grid[i1,j1].color = vp.color.white
            Solid_grid[i1+i2,j1+j2].color = vp.color.white
    
print(E(Solid))
